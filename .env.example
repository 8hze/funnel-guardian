# Optional external integrations.
# Funnel Guardian runs end-to-end with zero keys in Demo/Local Self-Healing mode,
# and automatically upgrades each adapter to live API calls when credentials are set.

# Stripe Test Mode (never use sk_live_ keys; production mutations are blocked by policy)
STRIPE_SECRET_KEY=

# Cognition Devin API v1 (https://docs.devin.ai/api-reference)
DEVIN_API_KEY=

# Linear GraphQL API (deduplication queue & incident tracking)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# GitHub REST API (automatic PR creation & Human Approval merge gate)
GITHUB_TOKEN=
GITHUB_REPOSITORY=wncu/funnel-guardian

# Sentry DSN (optional telemetry ingestion)
SENTRY_DSN=

# Local Chromium path override for Playwright probe
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
